#!/bin/sh
# 커밋 메시지 규칙 집행. 판정 정본은 scripts/commitMessage.mjs, 규칙 문장은 CLAUDE.md "Git 규칙".
# 이 훅은 얇게 유지한다: 판정 로직을 sh와 Node에 이중화하면 두 판정이 표류한다.
# 도구 흔적 차단(절대 게이트)도 그 정본 안에 있고, tests/run.mjs가 음성 fixture로 이빨을 증명한다.
message_file="$1"

if [ -z "$message_file" ] || [ ! -f "$message_file" ]; then
  echo "blocked: commit message file is missing" >&2
  exit 1
fi

# 실패는 닫는 방향으로 한다. node 없이 통과시키면 검사 없는 커밋이 조용히 들어온다.
if ! command -v node >/dev/null 2>&1; then
  echo "blocked: node is required to verify the commit message rule (CLAUDE.md \"Git 규칙\")" >&2
  exit 1
fi

repo_root="$(git rev-parse --show-toplevel)"
exec node "$repo_root/scripts/commitMessage.mjs" "$message_file"
