{
  "manifest_version": 3,
  "name": "pyproc User Browser",
  "description": "Lets a paired local pyproc control host work in one task window of this browser, with the debugging bar shown.",
  "version": "0.0.32",
  "key": "",
  "minimum_chrome_version": "137",
  "permissions": [
    "debugger",
    "nativeMessaging",
    "storage",
    "tabs",
    "windows"
  ],
  "background": {
    "service_worker": "serviceWorker.js",
    "type": "module"
  },
  "action": {
    "default_title": "pyproc User Browser"
  }
}
