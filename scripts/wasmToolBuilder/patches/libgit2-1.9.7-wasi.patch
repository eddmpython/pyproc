diff --git a/src/util/unix/realpath.c b/src/util/unix/realpath.c
index 2565e2e..dd80d96 100644
--- a/src/util/unix/realpath.c
+++ b/src/util/unix/realpath.c
@@ -18,6 +18,26 @@ char *p_realpath(const char *pathname, char *resolved)
 {
 	char *result;
 
+#ifdef __wasi__
+	size_t length;
+
+	if (!pathname || pathname[0] != '/') {
+		errno = ENOTSUP;
+		return NULL;
+	}
+	length = strlen(pathname);
+	if (length >= GIT_PATH_MAX) {
+		errno = ENAMETOOLONG;
+		return NULL;
+	}
+	result = resolved ? resolved : git__malloc(length + 1);
+	if (!result) {
+		errno = ENOMEM;
+		return NULL;
+	}
+	memcpy(result, pathname, length + 1);
+	return result;
+#else
 	if ((result = realpath(pathname, resolved)) == NULL)
 		return NULL;
 
@@ -45,6 +65,7 @@ char *p_realpath(const char *pathname, char *resolved)
 	}
 
 	return result;
+#endif
 }
 
 #endif
