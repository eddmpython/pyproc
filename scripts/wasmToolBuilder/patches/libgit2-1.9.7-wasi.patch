+	const char **env, size_t env_len, git_process_options *opts)
+{
+	GIT_UNUSED(cmdline); GIT_UNUSED(env); GIT_UNUSED(env_len); GIT_UNUSED(opts);
+	if (out) *out = NULL;
+	return wasi_process_unavailable();
+}
+
