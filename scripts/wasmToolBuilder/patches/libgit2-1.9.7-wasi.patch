+
+struct git_process { int unavailable; };
+
+static int wasi_process_unavailable(void)
+{
+	git_error_set(GIT_ERROR_OS, "child processes are unavailable on WASI");
+	return -1;
+}
+
+int git_process_new(git_process **out, const char **args, size_t args_len,
+	const char **env, size_t env_len, git_process_options *opts)
