+ssize_t git_process_write(git_process *process, const void *buf, size_t count)
+{ GIT_UNUSED(process); GIT_UNUSED(buf); GIT_UNUSED(count); return wasi_process_unavailable(); }
+int git_process_close_in(git_process *process) { GIT_UNUSED(process); return 0; }
+int git_process_close_out(git_process *process) { GIT_UNUSED(process); return 0; }
+int git_process_close_err(git_process *process) { GIT_UNUSED(process); return 0; }
+int git_process_close(git_process *process) { GIT_UNUSED(process); return 0; }
+int git_process_wait(git_process_result *result, git_process *process)
+{ GIT_UNUSED(result); GIT_UNUSED(process); return wasi_process_unavailable(); }
