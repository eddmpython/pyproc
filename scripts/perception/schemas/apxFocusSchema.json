{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pyproc.dev/schemas/apx/1/apx-focus.schema.json",
  "title": "APX Situation Focus 1.0",
  "type": "object",
  "required": ["requirements"],
  "properties": {
    "objective": { "type": "string", "maxLength": 1000 },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["requirementRef", "select", "need"],
        "properties": {
          "requirementRef": { "type": "string", "pattern": "^requirement:[A-Za-z0-9._:-]{1,128}$" },
          "select": {
            "type": "object",
            "minProperties": 1,
            "properties": {
              "entityRef": { "type": "string", "pattern": "^entity:[A-Za-z0-9_-]{1,128}$" },
              "kind": { "type": "string", "minLength": 1, "maxLength": 80 },
              "role": { "type": "string", "minLength": 1, "maxLength": 80 },
              "name": {
                "oneOf": [
                  { "type": "string", "maxLength": 300 },
                  { "type": "object", "minProperties": 1, "maxProperties": 1, "properties": {
                    "exact": { "type": "string", "maxLength": 300 },
                    "prefix": { "type": "string", "maxLength": 300 },
                    "contains": { "type": "string", "maxLength": 300 },
                    "token": { "type": "string", "maxLength": 100 },
                    "regex": { "type": "string", "maxLength": 100 }
                  }, "additionalProperties": false }
                ]
              },
              "state": { "type": "object", "maxProperties": 16 },
              "actionable": { "type": "boolean" }
            },
            "additionalProperties": false
          },
          "need": { "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true,
            "items": { "enum": ["fact", "affordance", "change"] } },
          "cardinality": { "enum": ["one", "oneOrMore", "zeroOrMore"] }
        },
        "additionalProperties": false
      }
    },
    "changedSince": { "type": "string", "pattern": "^situation:[a-f0-9]{64}$" },
    "freshness": {
      "type": "object",
      "required": ["mode", "maxAgeMs"],
      "properties": {
        "mode": { "enum": ["live", "recorded"] },
        "maxAgeMs": { "type": "integer", "minimum": 0, "maximum": 300000 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
