{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pyproc.dev/schemas/apx/1/apx-situation.schema.json",
  "title": "APX Situation Capsule 1.0",
  "type": "object",
  "required": ["protocol", "version", "representation", "profile", "situationRef", "worldRef",
    "observationRef", "documentEpoch", "capturedAt", "focus", "requirements", "facts", "affordances",
    "changes", "unknowns", "suggestedProbes", "completeness", "budget", "integrity"],
  "properties": {
    "protocol": { "const": "apx" },
    "version": { "const": "1.0" },
    "representation": { "const": "apx.situation" },
    "profile": { "type": "array", "minItems": 3, "maxItems": 5, "uniqueItems": true,
      "items": { "enum": ["apx-core/1", "apx-web/1", "apx-action/1", "apx-visual/1", "apx-situation/1"] },
      "allOf": [{ "contains": { "const": "apx-core/1" } }, { "contains": { "const": "apx-web/1" } },
        { "contains": { "const": "apx-situation/1" } }] },
    "situationRef": { "$ref": "#/$defs/situationRef" },
    "worldRef": { "$ref": "#/$defs/worldRef" },
    "observationRef": { "type": "string", "pattern": "^observation:[A-Za-z0-9_-]{1,128}$" },
    "documentEpoch": { "type": "integer", "minimum": 0 },
    "capturedAt": { "type": "string", "format": "date-time" },
    "focus": { "$ref": "apxFocusSchema.json" },
    "requirements": { "type": "array", "items": { "$ref": "#/$defs/requirement" } },
    "facts": { "type": "array", "items": { "$ref": "#/$defs/fact" } },
    "affordances": { "type": "array", "items": { "$ref": "#/$defs/affordance" } },
    "changes": { "type": "array", "items": { "type": "object" } },
    "unknowns": { "type": "array", "items": { "type": "object", "required": ["unknownRef", "requirementRef", "reason", "evidenceRefs"] } },
    "suggestedProbes": { "type": "array", "items": { "type": "object", "required": ["kind", "risk", "cost", "expectedInformation"] } },
    "visualProbes": { "type": "array", "maxItems": 8, "items": { "$ref": "apxVisualSchema.json#/$defs/visualProbe" } },
    "completeness": { "type": "object" },
    "budget": { "type": "object", "required": ["used", "omitted", "requiredPreserved"],
      "properties": { "used": { "type": "object" }, "omitted": { "type": "object" },
        "requiredPreserved": { "const": true } }, "additionalProperties": false },
    "integrity": { "type": "object", "required": ["canonicalSha256", "worldSha256", "sourceGraphSha256"],
      "properties": { "canonicalSha256": { "$ref": "#/$defs/digest" }, "worldSha256": { "$ref": "#/$defs/digest" },
        "sourceGraphSha256": { "$ref": "#/$defs/digest" } }, "additionalProperties": false }
  },
  "additionalProperties": false,
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "situationRef": { "type": "string", "pattern": "^situation:[a-f0-9]{64}$" },
    "worldRef": { "type": "string", "pattern": "^world:[a-f0-9]{64}$" },
    "provenance": { "type": "object", "required": ["mode", "source", "trust"],
      "properties": { "mode": { "enum": ["observed", "derived", "inferred", "reported"] },
        "source": { "type": "string", "minLength": 1 }, "trust": { "enum": ["broker", "browser", "page", "model", "external"] } },
      "additionalProperties": false },
    "requirement": { "type": "object", "required": ["requirementRef", "state", "cardinality", "matched", "entityRefs", "claimRefs", "candidateEvidence"],
      "properties": { "requirementRef": { "type": "string" }, "state": { "enum": ["satisfied", "conflicted", "unknown", "stale"] },
        "cardinality": { "enum": ["one", "oneOrMore", "zeroOrMore"] }, "matched": { "type": "integer", "minimum": 0 },
        "entityRefs": { "type": "array", "items": { "type": "string" } }, "claimRefs": { "type": "array", "items": { "type": "string" } },
        "candidateEvidence": { "$ref": "#/$defs/candidateEvidence" } },
      "additionalProperties": false },
    "candidateEvidence": { "type": "object", "required": ["surfaceEpoch", "universeScopeSha256", "enumeration",
      "observedCount", "droppedCount", "projectedCount", "omittedMatchedCount", "orderingSha256", "continuationRef"],
      "properties": { "surfaceEpoch": { "type": "string", "pattern": "^document:[0-9]+$" },
        "universeScopeSha256": { "$ref": "#/$defs/digest" }, "enumeration": { "enum": ["complete", "incomplete", "unknown"] },
        "observedCount": { "type": "integer", "minimum": 0 }, "droppedCount": { "type": "integer", "minimum": 0 },
        "matchedCount": { "type": "integer", "minimum": 0 }, "matchedLowerBound": { "type": "integer", "minimum": 0 },
        "projectedCount": { "type": "integer", "minimum": 0 }, "omittedMatchedCount": { "type": "integer", "minimum": 0 },
        "matchSetSha256": { "$ref": "#/$defs/digest" }, "orderingSha256": { "$ref": "#/$defs/digest" },
        "continuationRef": { "oneOf": [{ "type": "string", "pattern": "^continuation:[a-f0-9]{64}$" }, { "type": "null" }] } }, "additionalProperties": false,
      "allOf": [{ "if": { "properties": { "enumeration": { "const": "complete" } } },
        "then": { "required": ["matchedCount", "matchSetSha256"], "not": { "required": ["matchedLowerBound"] } },
        "else": { "required": ["matchedLowerBound"], "not": { "anyOf": [{ "required": ["matchedCount"] },
          { "required": ["matchSetSha256"] }] } } }] },
    "fact": { "type": "object", "required": ["claimRef", "subjectRef", "predicate", "scope", "state", "attestations"],
      "properties": { "claimRef": { "type": "string" }, "subjectRef": { "type": "string" }, "predicate": { "type": "string" },
        "scope": { "type": "string" }, "state": { "enum": ["known", "conflicted", "unknown", "stale"] }, "value": true,
        "attestations": { "type": "array", "items": { "type": "object", "required": ["subjectRef", "predicate", "scope", "provenance", "evidenceRefs", "freshness", "sensitivity"] } } },
      "additionalProperties": false },
    "affordance": { "type": "object", "required": ["kind", "action", "provenance"],
      "properties": { "kind": { "enum": ["observed", "derived", "reported", "authorized"] }, "action": { "type": "string" },
        "entityRef": { "type": "string" }, "reportedCapabilityRef": { "type": "string" }, "capabilityRef": { "type": "string" },
        "requirementRef": { "type": "string" }, "actionable": { "type": "boolean" }, "name": { "type": "string" },
        "destination": true, "origin": true, "revision": true, "worldRef": { "$ref": "#/$defs/worldRef" },
        "situationRef": { "$ref": "#/$defs/situationRef" }, "locatorRef": { "type": "string" }, "risk": { "type": "string" },
        "sessionKey": { "type": "string" }, "documentEpoch": { "type": "integer" }, "issuedAt": { "type": "string" },
        "expiresAt": { "type": "string" }, "preconditions": { "type": "array" }, "expectedTransition": { "type": "object" },
        "provenance": { "$ref": "#/$defs/provenance" } },
      "additionalProperties": false }
  }
}
