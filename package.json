{
  "name": "pyproc",
  "version": "0.0.17",
  "description": "A persistent Python computer in the browser: real CPython, durable workspaces, processes, rewindable history, and signed machine images. No application server. (브라우저에 영속하는 Python 컴퓨터.)",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eddmpython/pyproc.git"
  },
  "homepage": "https://github.com/eddmpython/pyproc#readme",
  "bugs": {
    "url": "https://github.com/eddmpython/pyproc/issues"
  },
  "main": "index.js",
  "types": "./index.d.ts",
  "bin": {
    "pyproc-assets": "./scripts/assetManifest.mjs",
    "pyproc-engine": "./scripts/fetchEngine.mjs",
    "pyproc-control": "./scripts/pyprocControl.mjs",
    "pyproc-mcp": "./scripts/pyprocMcp.mjs"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./runtime": {
      "types": "./src/composition/runtimeSubpath.d.ts",
      "default": "./src/composition/runtimeSubpath.js"
    },
    "./history": {
      "types": "./src/state/index.d.ts",
      "default": "./src/state/index.js"
    },
    "./machine": {
      "types": "./src/machine/index.d.ts",
      "default": "./src/machine/index.js"
    },
    "./worker": "./src/processOs/worker.js",
    "./assets": {
      "types": "./src/runtime/assets.d.ts",
      "default": "./src/runtime/assets.js"
    },
    "./gpu": {
      "types": "./src/capabilities/gpuCompute.d.ts",
      "default": "./src/capabilities/gpuCompute.js"
    },
    "./socket": {
      "types": "./src/capabilities/socketBridge.d.ts",
      "default": "./src/capabilities/socketBridge.js"
    },
    "./wasi": {
      "types": "./src/runtime/engines/wasi/wasiSession.d.ts",
      "default": "./src/runtime/engines/wasi/wasiSession.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "src",
    "scripts/assetManifest.mjs",
    "scripts/assetCatalog.json",
    "scripts/fetchEngine.mjs",
    "scripts/pyprocControl.mjs",
    "scripts/controlProtocolServer.mjs",
    "scripts/pyprocMcp.mjs",
    "scripts/mcpProductConfig.mjs",
    "scripts/mcpSandboxServer.mjs",
    "scripts/staticServer.mjs",
    "scripts/automationSpace",
    "scripts/controlProtocol",
    "scripts/browserControl",
    "README.md",
    "README.ko.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node tests/run.mjs",
    "test:types": "tsc -p tests/tsconfig.json",
    "test:contracts": "node tests/contracts/run.mjs",
    "assets:provenance": "node scripts/assetProvenance.mjs",
    "test:package": "node tests/packageGate.mjs",
    "test:installed": "node tests/browser/installedPackageGate.mjs",
    "test:web-computer": "node scripts/prepareWebComputerAssets.mjs && node tests/browser/webComputerProduct.mjs",
    "test:mcp": "node tests/browser/mcpSandbox.mjs",
    "test:mcp-product": "node tests/browser/installedMcpProduct.mjs",
    "test:control-product": "node tests/browser/controlProtocolProduct.mjs",
    "test:frame-space": "node tests/browser/frameSpaceProduct.mjs",
    "test:replay-space": "node tests/browser/replaySpaceProduct.mjs",
    "test:python-sdk": "node tests/pythonSdk/run.mjs",
    "test:browser-control": "node tests/browser/browserControl.mjs",
    "test:browser-control-stress": "node tests/browser/browserControlStress.mjs",
    "test:browser": "node tests/browser/run.mjs",
    "test:examples": "node tests/browser/examples.mjs",
    "bench:speed": "node tests/browser/speedBench.mjs",
    "bench:artifact": "node tests/browser/benchArtifact.mjs",
    "bench:compare": "node tests/browser/benchCompare.mjs",
    "assets:manifest": "node scripts/assetManifest.mjs --pretty",
    "assets:web-computer": "node scripts/prepareWebComputerAssets.mjs",
    "assets:buildroot": "node scripts/buildroot/buildGuest.mjs",
    "serve": "node scripts/staticServer.mjs",
    "fetch:engine": "node scripts/fetchEngine.mjs --out vendor/pyodide",
    "mcp:sandbox": "node scripts/mcpSandboxServer.mjs",
    "test:preflight": "node tests/browser/run.mjs tests/browser/preflightNoCoi.html",
    "test:web-machine": "node tests/webMachine/run.mjs",
    "test:web-machine:wasi": "node scripts/fetchWasiAssets.mjs && node tests/webMachine/run.mjs --wasi",
    "test:web-machine:v86": "node tests/webMachine/fixtures/v86/prepareAssets.mjs && node tests/webMachine/run.mjs --v86",
    "test:socket": "node tests/browser/socketLane.mjs",
    "test:golden": "node tests/browser/goldenWorkflow.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "keywords": [
    "python",
    "python-in-browser",
    "browser-computer",
    "persistent-state",
    "machine-image",
    "cpython",
    "pyodide",
    "browser",
    "wasm",
    "webassembly",
    "sandbox",
    "code-execution",
    "checkpoint",
    "snapshot",
    "time-travel",
    "process",
    "parallel",
    "reactive",
    "runtime",
    "repl",
    "ai-agent"
  ],
  "license": "MPL-2.0"
}
