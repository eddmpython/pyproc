{
  "name": "pyproc",
  "version": "0.0.22",
  "description": "A persistent Python computer in the browser: real CPython, durable workspaces, rewindable history, and evidence-backed browser eyes and hands. No application server. (브라우저에 영속하는 Python 컴퓨터.)",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eddmpython/pyproc.git"
  },
  "homepage": "https://github.com/eddmpython/pyproc#readme",
  "bugs": {
    "url": "https://github.com/eddmpython/pyproc/issues"
  },
  "main": "index.js",
  "types": "./index.d.ts",
  "bin": {
    "pyproc-assets": "./scripts/assetManifest.mjs",
    "pyproc-control": "./scripts/pyprocControl.mjs",
    "pyproc-mcp": "./scripts/pyprocMcp.mjs"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./runtime": {
      "types": "./src/composition/runtimeSubpath.d.ts",
      "default": "./src/composition/runtimeSubpath.js"
    },
    "./history": {
      "types": "./src/state/index.d.ts",
      "default": "./src/state/index.js"
    },
    "./machine": {
      "types": "./src/machine/index.d.ts",
      "default": "./src/machine/index.js"
    },
    "./worker": "./src/runtime/engines/wasi/wasiWorker.js",
    "./assets": {
      "types": "./src/runtime/assets.d.ts",
      "default": "./src/runtime/assets.js"
    },
    "./control": {
      "types": "./scripts/controlProtocol/controlApi.d.ts",
      "default": "./scripts/controlProtocol/controlApi.js"
    },
    "./gpu": {
      "types": "./src/composition/gpuSubpath.d.ts",
      "default": "./src/composition/gpuSubpath.js"
    },
    "./socket": {
      "types": "./src/capabilities/productHostCapabilities.d.ts",
      "default": "./src/capabilities/productHostCapabilities.js"
    },
    "./wasi": {
      "types": "./src/composition/wasiSubpath.d.ts",
      "default": "./src/composition/wasiSubpath.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "src",
    "scripts/assetManifest.mjs",
    "scripts/assetCatalog.json",
    "scripts/engineBuilder",
    "scripts/scientificPackageBuilder",
    "scripts/nativePackageCatalog",
    "scripts/pyprocControl.mjs",
    "scripts/controlProtocolServer.mjs",
    "scripts/pyprocMcp.mjs",
    "scripts/mcpProductConfig.mjs",
    "scripts/machineEntrance",
    "scripts/mcpSandboxServer.mjs",
    "scripts/staticServer.mjs",
    "scripts/automationSpace",
    "scripts/controlProtocol",
    "scripts/executionMemory",
    "scripts/effectTransaction",
    "scripts/appSpace",
    "scripts/replayGraph",
    "scripts/actuation",
    "scripts/browserControl",
    "scripts/perception",
    "scripts/verification",
    "scripts/skillOs",
    "skills",
    "README.md",
    "README.ko.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node tests/run.mjs",
    "test:types": "tsc -p tests/tsconfig.json",
    "test:contracts": "node tests/contracts/run.mjs",
    "test:engine-independence": "node scripts/engineIndependence/scanEngineIndependence.mjs --packed",
    "assets:provenance": "node scripts/assetProvenance.mjs",
    "test:package": "node tests/packageGate.mjs",
    "test:installed": "node tests/browser/installedPackageGate.mjs",
    "test:web-computer": "node scripts/prepareWebComputerAssets.mjs && node tests/browser/webComputerProduct.mjs",
    "test:mcp": "node tests/browser/mcpSandbox.mjs",
    "test:mcp-product": "node tests/browser/installedMcpProduct.mjs",
    "test:control-product": "node tests/browser/controlProtocolProduct.mjs",
    "test:frame-space": "node tests/browser/frameSpaceProduct.mjs",
    "test:app-space": "node tests/browser/appSpaceProduct.mjs",
    "test:replay-graph": "node tests/browser/replayGraphProduct.mjs",
    "test:actuation": "node tests/browser/actuationProduct.mjs",
    "test:windows-motor": "node tests/windowsMotor/run.mjs",
    "test:delegated-tab": "node tests/browser/delegatedTabProduct.mjs",
    "test:replay-space": "node tests/browser/replaySpaceProduct.mjs",
    "test:python-sdk": "node tests/pythonSdk/run.mjs",
    "test:apx": "node tests/browser/apxProduct.mjs",
    "test:perception-computer": "node tests/browser/apxProduct.mjs",
    "test:experience-verification": "node tests/browser/experienceVerificationProduct.mjs",
    "test:browser-control": "node tests/browser/browserControl.mjs",
    "test:browser-control-stress": "node tests/browser/browserControlStress.mjs",
    "test:automation-lifecycle": "node tests/browser/automationLifecycleProduct.mjs",
    "test:action-convergence": "node tests/browser/actionConvergenceProduct.mjs",
    "test:hardware-visual-oracle": "node tests/browser/hardwareVisualOracleProduct.mjs",
    "test:browser": "node tests/browser/run.mjs",
    "test:storage-durability": "node tests/browser/storageDurabilityProduct.mjs",
    "test:examples": "node tests/browser/examples.mjs",
    "bench:speed": "node tests/browser/speedBench.mjs",
    "bench:artifact": "node tests/browser/benchArtifact.mjs",
    "bench:compare": "node tests/browser/benchCompare.mjs",
    "assets:manifest": "node scripts/assetManifest.mjs --pretty",
    "assets:web-computer": "node scripts/prepareWebComputerAssets.mjs",
    "assets:buildroot": "node scripts/buildroot/buildGuest.mjs",
    "assets:native-packages": "node scripts/nativePackageCatalog/buildNativePackageCatalog.mjs",
    "serve": "node scripts/staticServer.mjs",
    "mcp:sandbox": "node scripts/mcpSandboxServer.mjs",
    "test:preflight": "node tests/browser/run.mjs tests/browser/preflightNoCoi.html",
    "test:web-machine": "node tests/webMachine/run.mjs",
    "test:web-machine:v86": "node tests/webMachine/fixtures/v86/prepareAssets.mjs && node tests/webMachine/run.mjs --v86",
    "test:golden": "node tests/browser/goldenWorkflow.mjs",
    "skills:catalog": "node scripts/skillOs/catalog.mjs",
    "skills:check": "node scripts/skillOs/validate.mjs",
    "skills:test-routing": "node tests/skillOs/routing.mjs",
    "skills:test-package": "node tests/skillOs/package.mjs",
    "skills:test-mcp": "node tests/skillOs/mcp.mjs",
    "skills:test-forward": "node tests/skillOs/forward.mjs",
    "skills:test-performance": "node tests/skillOs/performance.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "keywords": [
    "python",
    "python-in-browser",
    "browser-computer",
    "persistent-state",
    "machine-image",
    "cpython",
    "browser",
    "wasm",
    "webassembly",
    "sandbox",
    "code-execution",
    "checkpoint",
    "snapshot",
    "time-travel",
    "process",
    "parallel",
    "reactive",
    "runtime",
    "repl",
    "ai-agent",
    "browser-automation",
    "agent-perception",
    "mcp",
    "cdp"
  ],
  "license": "MPL-2.0"
}
